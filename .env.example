# MongoDB connection (optional for guest-only previews; required for accounts)
MONGODB_URI="mongodb://127.0.0.1:27017"
MONGODB_DB="motionly"

# Used to sign session cookies. Set a long random value in production.
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional: point Remotion at an existing Chrome/Chromium binary.
# On Windows, a locally installed Chrome or Edge is detected automatically.
# REMOTION_BROWSER_EXECUTABLE="C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe"

# Maximum simultaneous renders in this server process.
RENDER_CONCURRENCY="2"
